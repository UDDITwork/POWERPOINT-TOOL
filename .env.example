# ========================================
# AI PATENT DIAGRAM GENERATOR - ENVIRONMENT CONFIGURATION
# ========================================

# ----------------------------------------
# ANTHROPIC CLAUDE API
# ----------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4.5-20250929
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# ----------------------------------------
# BACKEND CONFIGURATION
# ----------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=info

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ----------------------------------------
# REDIS & CELERY
# ----------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_CONCURRENCY=4

# ----------------------------------------
# FILE STORAGE
# ----------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=./generated_diagrams
STORAGE_MAX_AGE_DAYS=7

# For cloud storage (optional):
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=patent-diagrams
# AWS_REGION=us-east-1

# ----------------------------------------
# DATABASE (Optional - for user sessions)
# ----------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./patent_diagrams.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/patent_diagrams

# ----------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------
# Maximum concurrent diagram generation jobs
MAX_CONCURRENT_JOBS=15

# Session expiration (in seconds)
SESSION_EXPIRATION=3600

# Maximum shapes per diagram
MAX_SHAPES_PER_DIAGRAM=100

# Default slide dimensions (inches)
DEFAULT_SLIDE_WIDTH=10.0
DEFAULT_SLIDE_HEIGHT=7.5

# ----------------------------------------
# SECURITY
# ----------------------------------------
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------
# FEATURE FLAGS
# ----------------------------------------
ENABLE_PREVIEW_GENERATION=true
ENABLE_SESSION_MANAGEMENT=true
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# ----------------------------------------
# DEVELOPMENT
# ----------------------------------------
DEBUG=false
TESTING=false
